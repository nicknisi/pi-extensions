{
  "name": "@nicknisi/pi-agent-urls",
  "version": "0.2.4",
  "description": "agent:// and history:// URL tools for reading pi-subagents runs, outputs, and transcripts",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/nicknisi/pi-extensions/tree/main/packages/agent-urls#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicknisi/pi-extensions.git",
    "directory": "packages/agent-urls"
  },
  "files": [
    "dist",
    "index.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nicknisi/pi-shared": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
