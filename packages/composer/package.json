{
  "name": "@nicknisi/pi-composer",
  "version": "0.4.0",
  "description": "Configurable boxed input editor for pi, with paste-again-to-expand",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/nicknisi/pi-extensions/tree/main/packages/composer#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicknisi/pi-extensions.git",
    "directory": "packages/composer"
  },
  "files": [
    "dist",
    "index.ts",
    "config.ts",
    "utils.ts",
    "README.md",
    "composer.example.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
