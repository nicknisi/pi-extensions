{
  "name": "@nicknisi/pi-composer",
  "version": "1.0.0",
  "description": "The whole bottom of pi's screen: input box, footer, working message and spinner, as configurable styles and slots",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/nicknisi/pi-extensions/tree/main/packages/composer#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicknisi/pi-extensions.git",
    "directory": "packages/composer"
  },
  "files": [
    "dist",
    "index.ts",
    "config.ts",
    "styles.ts",
    "state.ts",
    "layout.ts",
    "items.ts",
    "render.ts",
    "editor.ts",
    "focus.ts",
    "data.ts",
    "verbs.ts",
    "utils.ts",
    "README.md",
    "composer.example.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
