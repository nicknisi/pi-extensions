{
  "name": "@nicknisi/pi-answer",
  "version": "0.3.8",
  "description": "Extract questions from the last assistant reply into an interactive Q&A form and send the answers back",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/nicknisi/pi-extensions/tree/main/packages/answer#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicknisi/pi-extensions.git",
    "directory": "packages/answer"
  },
  "files": [
    "dist",
    "index.ts",
    "config.ts",
    "answer.example.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nicknisi/pi-shared": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
